<style>
  body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    background-attachment: fixed !important;
    min-height: 100vh;
  }
</style>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - Task Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <span class="navbar-brand">📝 Task Planner App</span>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Halo, <strong><%= username %></strong></span>
                <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Statistik Summary (Fitur 3) -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-primary shadow-sm mb-2">
                    <div class="card-body text-center">
                        <h6>Total Tugas</h6>
                        <h2><%= stats.total || 0 %></h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-warning shadow-sm mb-2">
                    <div class="card-body text-center">
                        <h6>Pending</h6>
                        <h2><%= stats.pending || 0 %></h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-success shadow-sm mb-2">
                    <div class="card-body text-center">
                        <h6>Selesai</h6>
                        <h2><%= stats.finished || 0 %></h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Form Tambah Tugas (Fitur 4) -->
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white font-weight-bold">Tambah Tugas Baru</div>
                    <div class="card-body">
                        <form action="/tasks/create" method="POST">
                            <div class="mb-3">
                                <label>Judul Tugas</label>
                                <input type="text" name="title" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label>Kategori</label>
                                <select name="category" class="form-select">
                                    <option value="Kuliah">Kuliah</option>
                                    <option value="Kerja">Kerja</option>
                                    <option value="Pribadi">Pribadi</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label>Prioritas</label>
                                <select name="priority" class="form-select">
                                    <option value="Rendah">Rendah</option>
                                    <option value="Sedang" selected>Sedang</option>
                                    <option value="Tinggi">Tinggi</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label>Deadline</label>
                                <input type="date" name="deadline" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label>Deskripsi</label>
                                <textarea name="description" class="form-control" rows="2"></textarea>
                            </div>
                            <button class="btn btn-primary w-100">Simpan Tugas</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Filter, Search & Task List (Fitur 5, 6, 7, 8) -->
            <div class="col-md-8">
                <!-- Search & Filter Bar (Fitur 6) -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <form method="GET" action="/dashboard" class="row g-2">
                            <div class="col-md-4">
                                <input type="text" name="search" class="form-control" placeholder="Cari tugas..." value="<%= filters.search || '' %>">
                            </div>
                            <div class="col-md-3">
                                <select name="category" class="form-select">
                                    <option value="">Semua Kategori</option>
                                    <option value="Kuliah" <%= filters.category === 'Kuliah' ? 'selected' : '' %>>Kuliah</option>
                                    <option value="Kerja" <%= filters.category === 'Kerja' ? 'selected' : '' %>>Kerja</option>
                                    <option value="Pribadi" <%= filters.category === 'Pribadi' ? 'selected' : '' %>>Pribadi</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select name="priority" class="form-select">
                                    <option value="">Semua Prioritas</option>
                                    <option value="Rendah" <%= filters.priority === 'Rendah' ? 'selected' : '' %>>Rendah</option>
                                    <option value="Sedang" <%= filters.priority === 'Sedang' ? 'selected' : '' %>>Sedang</option>
                                    <option value="Tinggi" <%= filters.priority === 'Tinggi' ? 'selected' : '' %>>Tinggi</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-secondary w-100">Filter</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- List Tugas (Fitur 5) -->
                <div class="list-group shadow-sm">
                    <% if (tasks.length === 0) { %>
                        <div class="list-group-item text-center text-muted py-4">Belum ada tugas tercatat.</div>
                    <% } %>
                    <% tasks.forEach(task => { %>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1 <%= task.status === 'Selesai' ? 'text-decoration-line-through text-muted' : '' %>">
                                    <%= task.title %>
                                </h5>
                                <p class="mb-1 text-muted small"><%= task.description || 'Tidak ada deskripsi' %></p>
                                <span class="badge bg-info"><%= task.category %></span>
                                <span class="badge <%= task.priority === 'Tinggi' ? 'bg-danger' : task.priority === 'Sedang' ? 'bg-warning text-dark' : 'bg-secondary' %>">
                                    <%= task.priority %>
                                </span>
                                <% if(task.deadline) { %>
                                    <small class="text-muted ms-2">⏰ <%= new Date(task.deadline).toLocaleDateString('id-ID') %></small>
                                <% } %>
                            </div>
                            <div class="d-flex gap-2">
                                <!-- Status Toggle (Fitur 7) -->
                                <form action="/tasks/toggle/<%= task.id %>" method="POST">
                                    <button class="btn btn-sm <%= task.status === 'Selesai' ? 'btn-outline-warning' : 'btn-success' %>">
                                        <%= task.status === 'Selesai' ? 'Batal' : 'Selesai' %>
                                    </button>
                                </form>
                                <!-- Hapus Tugas (Fitur 8) -->
                                <form action="/tasks/delete/<%= task.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus?')">
                                    <button class="btn btn-sm btn-outline-danger">Hapus</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>